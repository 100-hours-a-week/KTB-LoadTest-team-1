# Copy this file to .env and adjust values for your environment

ENCRYPTION_KEY=change_me_64_hex_chars____________________________________
ENCRYPTION_SALT=change_me_32_hex_chars________________
JWT_SECRET=change_me_secure_jwt_secret

MONGO_URI=mongodb://localhost:27017/bootcamp-chat

PORT=5001
WS_PORT=5002

OPENAI_API_KEY=sk-...

# S3 파일 저장을 쓰려면 FILE_STORAGE_TYPE=s3 로 바꾸고 아래 값을 채운다 (기본은 local)
FILE_STORAGE_TYPE=local
AWS_S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Socket.IO 크로스 인스턴스 스토어(멀티 인스턴스 배포 시 필수)를 쓰려면
# SOCKETIO_STORE_TYPE=redis 로 바꾸고 아래 값을 채운다 (기본은 local, 단일 노드 전용)
SOCKETIO_STORE_TYPE=local
REDIS_SOCKETIO_HOST=localhost
REDIS_SOCKETIO_PORT=6380
REDIS_SOCKETIO_PASSWORD=

# 세션을 Redis로 옮기려면 SESSION_STORE_TYPE=redis 로 바꾸고 아래 값을 채운다
# (기본은 mongo — MongoDB TTL 기반, 인스턴스 여러 대여도 정합성은 유지되지만 왕복비용이 더 큼)
SESSION_STORE_TYPE=mongo
REDIS_SESSION_HOST=localhost
REDIS_SESSION_PORT=6379
REDIS_SESSION_PASSWORD=

# rate limit을 Redis로 옮기려면 RATELIMIT_STORE_TYPE=redis 로 바꾼다
# (세션이랑 같은 Redis 인스턴스를 DB index만 다르게 써서, REDIS_SESSION_* 값을 그대로 재사용한다)
RATELIMIT_STORE_TYPE=mongo
