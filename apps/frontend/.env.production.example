# 프로덕션 빌드용 환경 변수 템플릿.
# `pnpm run build:production` 전에 이 파일을 .env.production 으로 복사한 뒤
# 배포 대상 주소로 값을 고치세요. (.env.production 은 커밋하지 않습니다)
NEXT_PUBLIC_API_URL=http://localhost:5001
NEXT_PUBLIC_SOCKET_URL=http://localhost:5002

# 정적 자산을 CDN에서 서빙하는 배포(build:production)에서만 설정한다.
# Docker 배포는 컨테이너가 자체적으로 정적 자산을 서빙하므로 비워둔다 —
# next build는 NODE_ENV를 항상 production으로 강제해서 그걸로는 두 배포
# 경로를 구분할 수 없기 때문에, 이 값의 존재 여부로 직접 구분한다.
CDN_ASSET_PREFIX=https://d27gb4vxgiasxt.cloudfront.net
CDN_ASSET_BUCKET=ktb-chat-nextjs-assets
